# Frontend Environment Variables
# Copy this file to .env and update with your actual values

# API Base URL - Backend API endpoint
REACT_APP_API_BASE_URL=https://yggdrasilsolution.com/backend_pos

# Homepage URL - Used for building and routing
# For subdirectory deployment: /moredansmv
# For root deployment: leave empty or /
REACT_APP_HOMEPAGE=https://yggdrasilsolution.com/moredansmv

# Public URL - Usually extracted from HOMEPAGE automatically
# Only set if needed, otherwise leave commented
# REACT_APP_PUBLIC_URL=/moredansmv
